# Backend
GEMINI_API_KEY=
# Optional: override the Gemini model used for image recipe extraction
# GEMINI_VISION_MODEL=gemini-2.5-flash-lite
OLLAMA_URL=http://localhost:11434
DB_DIR=./data/db
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3000
# For mobile dev: add your machine's LAN IP so the Expo app can reach the backend
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.X:8000

# Frontend (web)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mobile
# Replace with your machine's LAN IP when testing on a physical device or simulator
EXPO_PUBLIC_API_URL=http://192.168.1.X:8000
