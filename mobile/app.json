{
  "expo": {
    "name": "Hestia",
    "slug": "hestia",
    "scheme": "hestia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Hestia uses the camera to scan a recovery QR from another signed-in device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Hestia uses the camera to scan a recovery QR from another signed-in device."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/96b8d4d7-0c87-4541-8e8d-8bc8b74c1652"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96b8d4d7-0c87-4541-8e8d-8bc8b74c1652"
      }
    },
    "owner": "sharvilpatel95"
  }
}
