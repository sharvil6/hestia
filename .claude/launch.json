{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "frontend"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd backend && backend\\.venv\\Scripts\\uvicorn.exe main:app --reload"],
      "port": 8000
    }
  ]
}
