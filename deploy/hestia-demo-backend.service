[Unit]
Description=Hestia FastAPI backend (public demo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hestia
Group=hestia
WorkingDirectory=/srv/hestia/repo/backend
# Optional secrets file — the demo deliberately has no GEMINI_API_KEY (vision is
# disabled by HESTIA_DEMO_MODE anyway). The leading '-' makes it optional.
EnvironmentFile=-/srv/hestia/demo.env
Environment=DB_DIR=/srv/hestia/demo/data/db
Environment=UPLOAD_DIR=/srv/hestia/demo/data/uploads
Environment=CORS_ORIGINS=https://hestia-demo.sharvilpatel.dev
# Demo mode: disables the Gemini-vision endpoints and enables /auth/demo-login.
Environment=HESTIA_DEMO_MODE=1
# Distinct cookie name so the demo session never clobbers a real prod session —
# both sites are under .sharvilpatel.dev and would otherwise share the cookie.
Environment=HESTIA_COOKIE_NAME=hestia_demo_session
Environment=HESTIA_COOKIE_SECURE=true
Environment=HESTIA_COOKIE_SAMESITE=lax
Environment=HESTIA_COOKIE_DOMAIN=.sharvilpatel.dev
Environment=HESTIA_PUBLIC_URL=https://hestia-demo.sharvilpatel.dev
Environment=HESTIA_RP_ID=hestia-demo.sharvilpatel.dev
Environment=HESTIA_RP_NAME=Hestia Demo
Environment=HESTIA_EXPECTED_ORIGINS=https://hestia-demo.sharvilpatel.dev
ExecStart=/srv/hestia/repo/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/hestia/demo/data

[Install]
WantedBy=multi-user.target
