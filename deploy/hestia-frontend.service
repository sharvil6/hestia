[Unit]
Description=Hestia Next.js frontend
After=network-online.target hestia-backend.service
Wants=network-online.target

[Service]
Type=simple
User=hestia
Group=hestia
WorkingDirectory=/srv/hestia/frontend-runtime
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node frontend/server.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
